<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!--
        The notice table is created by the historical changeset 005 and then
        removed here. Keeping the old changeset untouched preserves the checksum
        of databases created by the previous task; the new changeset performs the
        actual migration to Cassandra.
    -->
    <changeSet id="007-drop-legacy-notice" author="distcomp">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="tbl_notice" schemaName="distcomp"/>
        </preConditions>
        <comment>Notices moved to Cassandra; remove the relational table</comment>
        <dropTable tableName="tbl_notice" schemaName="distcomp"/>
    </changeSet>

</databaseChangeLog>
